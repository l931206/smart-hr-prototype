DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://l931206.github.io
CSRF_TRUSTED_ORIGINS=https://l931206.github.io
AUTH_MODE=hybrid
ENABLE_MOCK_CENTRAL=1
MOCK_CENTRAL_TOKEN_MAX_AGE=900
CENTRAL_SYSTEM_CODE=smart-hr
CENTRAL_TOKEN_VERIFY_URL=
CENTRAL_TOKEN_FIELD=token
CENTRAL_API_KEY=
DATABASE_URL=

# Leave empty to use SQLite locally. Set these for PostgreSQL.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
